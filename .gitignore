# ──────────────────────────────────────────────────────
# BinGo — .gitignore
# ──────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Environment variables ─────────────────────────────
# Keep .env.example (safe template with no secrets)
.env
.env.*
!.env.example

# ── Logs & diagnostics ───────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Runtime data ──────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Vite / Tailwind / PostCSS caches ─────────────────
.vite/
*.tsbuildinfo

# ── Testing & coverage ───────────────────────────────
coverage/
.nyc_output/

# ── Editor & OS files ─────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── ML training artifacts (large binaries) ────────────
# Keep training/train.py (source) and training/work/report.json (results).
# Exclude large model checkpoints, feature caches, and saved models
# that can be regenerated from the training script.
training/work/saved_model/
training/work/*.keras
training/work/*.h5
training/work/*.npz
training/work/*.pb

# Raw training data directories
dataset/
raw_images/

# ── Dev-only patch & bundle files ─────────────────────
# One-time development artifacts; not needed in production repo
*.patch
*.bundle
patches/

# ── Vercel local artifacts ────────────────────────────
.vercel/
