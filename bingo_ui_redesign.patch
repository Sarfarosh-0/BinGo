+    return () => window.removeEventListener('keydown', handleKeyDown)
+  }, [isOpen, onClose])
+
+  if (!isOpen) return null
+
+  const active = CATEGORY_DETAILS[selectedKey] || CATEGORY_DETAILS.recyclable
